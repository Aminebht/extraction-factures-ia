# Fournisseurs d'IA, choisis séparément pour l'OCR et pour le LLM.
# Configuration exigée par le sujet : mistral pour les deux. Les autres servent au développement.
# OCR_PROVIDER : mistral | gemini | cloudflare — LLM_PROVIDER : mistral | gemini | cloudflare
# (pas de commentaire en fin de ligne : Docker ne les retire pas tous)
OCR_PROVIDER=mistral
LLM_PROVIDER=mistral

# --- Mistral (console.mistral.ai, tier « Experiment » gratuit) ---
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=mistral-medium-latest

# --- Google Gemini, OCR et LLM (aistudio.google.com > Get API key, gratuit) ---
# OCR : lit le PDF par vision. Pas de score de confiance par mot (aucun champ « à vérifier »).
# Les données du tier gratuit peuvent servir à entraîner les modèles de Google : jamais de vraies factures.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_MAX_TOKENS=32768

# --- Cloudflare Workers AI (dash.cloudflare.com > AI > Workers AI > Use REST API) ---
# LLM : un modèle Mistral hébergé par Cloudflare. OCR : toMarkdown lit la couche texte du PDF au lieu
# du rendu visuel (pas de confiance, mojibake sur la facture 4, aucun texte sur le scan de la facture 3).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLM_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# Nombre de factures traitées en parallèle (les tiers gratuits ont une limite de débit basse).
CONCURRENCY=2

# Dossier d'entrée et fichier de sortie du pipeline.
INVOICES_DIR=factures
OUTPUT_PATH=output/results.json

# Seuil de confiance OCR en dessous duquel un champ ancré passe « à vérifier ».
OCR_CONFIDENCE_THRESHOLD=0.8

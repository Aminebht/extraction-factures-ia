{
  "name": "juwa-extraction-factures",
  "private": true,
  "type": "module",
  "description": "Pipeline d'extraction de factures fournisseurs (Mistral OCR + LLM) et interface de vérification",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pipeline": "npm run pipeline -w @juwa/pipeline --",
    "dev": "npm run dev -w @juwa/web",
    "start": "npm run pipeline && npm run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
